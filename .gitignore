# =============================================================================
# KiCad
# =============================================================================

# Per-machine UI/session state (open tabs, zoom, selection)
*.kicad_prl

# Backups, autosaves and lock files
*-backups/
*.bak
*.kicad_pcb-bak
*.kicad_sch-bak
_autosave-*
~*.lck

# Caches and exports regenerated from the schematic/PCB
*.net
fp-info-cache

# =============================================================================
# Fabrication
# =============================================================================

# SQLite cache written by the JLCPCB fabrication-toolkit plugin
fabrication/jlcpcb/project.db

# =============================================================================
# Firmware (EWARM / CubeIDE / GCC)
# =============================================================================

# Build output directories
Debug/
Release/
build/
firmware/EWARM/Debug/
firmware/EWARM/settings/

# Object files and dependency info
*.d
*.dep
*.o
*.su

# Linked images, maps and listings
*.bin
*.elf
*.hex
*.list
*.map

# EWARM browse/tag info
*.ewt

# =============================================================================
# IDEs and editors
# =============================================================================

# Eclipse / STM32CubeIDE
.cproject
.project
.settings/

# VS Code / JetBrains / local history
.history/
.idea/
.vscode/

# Claude Code
.claude/

# =============================================================================
# Operating system / OneDrive
# =============================================================================

.DS_Store
Thumbs.db
desktop.ini
