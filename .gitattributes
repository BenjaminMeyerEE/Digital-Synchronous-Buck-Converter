# Normalize line endings so Windows/Unix checkouts don't churn
* text=auto

# Vendor code (ST HAL, CMSIS, ARM) - not authored here.
# Keeps GitHub's language stats and diffs focused on the actual firmware.
firmware/Drivers/**                   linguist-vendored
firmware/EWARM/startup_stm32g474xx.s  linguist-vendored

# KiCad design files are text, but their diffs are unreadable s-expressions
*.kicad_pcb   -diff
*.kicad_sch   -diff

# Binaries
*.step   binary
*.STEP   binary
*.stp    binary
*.a      binary
*.zip    binary
*.db     binary
